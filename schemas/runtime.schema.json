{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEDPANEL Runtime format 2.0 / specification 1.1",
  "description": "Normative structure. Cross-reference, time, size, topology and hash rules are in docs/02-data-format.md and docs/08-scalability.md.",
  "type": "object",
  "properties": {
    "version": {
      "const": 2
    },
    "projectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "layouts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\u0000]*$"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                },
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4095
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4095
                }
              },
              "required": [
                "id",
                "x",
                "y"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 16
          }
        },
        "required": [
          "id",
          "name",
          "width",
          "height",
          "slots"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    },
    "defaultLayout": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "minItems": 0,
      "maxItems": 512
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "cues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cue"
      },
      "minItems": 1,
      "maxItems": 128
    },
    "runtimeMinor": {
      "const": 0
    },
    "renderer": {
      "const": "lp-raster-1"
    },
    "fps": {
      "const": 30
    }
  },
  "required": [
    "version",
    "projectId",
    "layouts",
    "defaultLayout",
    "assets",
    "scenes",
    "cues",
    "runtimeMinor",
    "renderer",
    "fps"
