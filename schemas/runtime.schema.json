          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        }
