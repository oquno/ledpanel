              "items": {
                "type": "object",
                "properties": {
                  "tick": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18000
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "ease": {
                    "enum": [
                      "linear",
                      "step"
                    ]
                  }
