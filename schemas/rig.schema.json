{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEDPANEL Rig 2.0",
  "type": "object",
  "properties": {
    "version": {
      "const": 2
    },
    "groupId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "masterNodeId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "hardwareId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\u0000]*$"
          },
          "role": {
            "enum": [
              "master",
              "follower"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "boardProfile": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "rotation": {
            "enum": [
              0,
              180
            ]
          },
          "brightnessCap": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "required": [
          "nodeId",
          "hardwareId",
          "label",
          "role",
          "enabled",
          "boardProfile",
          "rotation",
          "brightnessCap"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    },
    "layouts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "layoutId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slotId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                },
                "nodeId": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "slotId",
                "nodeId"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 16
          }
        },
        "required": [
          "layoutId",
          "bindings"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 16
    }
  },
  "required": [
    "version",
    "groupId",
    "masterNodeId",
    "revision",
    "nodes",
    "layouts"
  ],
  "additionalProperties": false
}
